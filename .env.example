# Leave these unset and the site runs entirely off the bundled dataset in
# src/data/orchards.json. That is the Phase 1 state, and it is a supported one:
# the map works with no database at all.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Admin access for scripts/db.mjs (migrations + ad-hoc SQL). Just the database
# password — host, port and user are derived from PUBLIC_SUPABASE_URL above.
# This one IS a real secret, unlike the publishable key: it is full database
# access and bypasses RLS entirely. Never goes in the bundle; .env is
# gitignored, and it must stay that way.
SUPABASE_DB_PASSWORD=

# Only if the derived host is wrong, or you would rather paste a full URL.
# SUPABASE_DB_HOST=aws-0-us-east-1.pooler.supabase.com
# SUPABASE_DB_URL=

# Only needed to CREATE the Supabase project (scripts/provision-supabase.mjs).
# A personal access token from supabase.com/dashboard/account/tokens — it can
# create and delete projects across your whole account, so it is a bigger
# secret than anything else in this file. Remove it once the project exists;
# nothing in the app or the deploy ever needs it.
SUPABASE_ACCESS_TOKEN=
