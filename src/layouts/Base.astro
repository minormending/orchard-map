---
// Vendor first. maplibre-gl.css sets `.maplibregl-map { position: relative }`
// on the very element we position absolutely, and at equal specificity the
// later sheet wins — which silently collapsed the map to zero height.
import 'maplibre-gl/dist/maplibre-gl.css'
import '../styles/app.css'

interface Props {
  title: string
  description: string
  /** Set on the orchard pages so each one is canonical to itself. */
  canonical?: string
  wide?: boolean
}

const { title, description, canonical, wide = false } = Astro.props
const base = import.meta.env.BASE_URL
const href = canonical ?? new URL(Astro.url.pathname, Astro.site).href
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={href} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="robots" content="index,follow" />
  </head>
  <body>
    <div class:list={["site", wide && "site-fixed"]}>
      <header class="site-head">
        <h1><a href={base}>Orchard Map</a></h1>
        <p class="tagline">Apple picking within a day trip of New York</p>
        <nav>
          <a href={base}>Map</a>
          <a href={`${base}about`}>About</a>
        </nav>
      </header>

      {wide ? <slot /> : <main class="page"><slot /></main>}

      <footer class:list={["site-foot", wide && "site-foot-compact"]}>
        <p>
          Listings from the <a href="https://www.applesfromny.com/" rel="noreferrer nofollow">New York Apple
          Association</a>, which states no licence for them. Opening hours and whether
          picking is open are <strong>not</strong> checked yet — ring ahead.
        </p>
        <p>
          Map data © <a href="https://www.openstreetmap.org/copyright" rel="noreferrer">OpenStreetMap</a>
          contributors · tiles by <a href="https://carto.com/attributions" rel="noreferrer">CARTO</a> ·
          <a href="https://github.com/minormending/orchard-map" rel="noreferrer">source</a>
        </p>
      </footer>
    </div>
  </body>
</html>
