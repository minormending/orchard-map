---
// Vendor first. maplibre-gl.css sets `.maplibregl-map { position: relative }`
// on the very element we position absolutely, and at equal specificity the
// later sheet wins — which silently collapsed the map to zero height.
import 'maplibre-gl/dist/maplibre-gl.css'
import '../styles/app.css'
import BuildTag from '../components/BuildTag.astro'
import { ClientRouter } from 'astro:transitions'

interface Props {
  title: string
  description: string
  /** Set on the orchard pages so each one is canonical to itself. */
  canonical?: string
  wide?: boolean
}

const { title, description, canonical, wide = false } = Astro.props
const base = import.meta.env.BASE_URL
const href = canonical ?? new URL(Astro.url.pathname, Astro.site).href
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={href} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="robots" content="index,follow" />
    {/*
      Cross-document view transitions. Every navigation here was a hard cut,
      which is the single most dated thing about moving around the site.

      Worth saying what this does NOT change: the pages are still 306 static
      HTML files and every URL still works on its own. The router swaps
      documents it has already fetched instead of repainting from white, and a
      browser without the API just navigates as before. Nothing about the
      crawlable surface — the reason this is Astro at all — moves.
    */}
    <ClientRouter />
  </head>
  <body>
    <div class:list={["site", wide && "site-fixed"]}>
      <header class="site-head">
        <h1><a href={base}>Orchard Map</a></h1>
        <nav>
          <a href={base}>Map</a>
          <a href={`${base}varieties`}>Calendar</a>
          <a href={`${base}about`}>About</a>
          <BuildTag />
        </nav>
      </header>

      {wide ? <slot /> : <main class="page"><slot /></main>}
    </div>
  </body>
</html>
