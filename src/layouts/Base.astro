---
// Vendor first. maplibre-gl.css sets `.maplibregl-map { position: relative }`
// on the very element we position absolutely, and at equal specificity the
// later sheet wins — which silently collapsed the map to zero height.
import 'maplibre-gl/dist/maplibre-gl.css'
import '../styles/app.css'
import BuildTag from '../components/BuildTag.astro'

interface Props {
  title: string
  description: string
  /** Set on the orchard pages so each one is canonical to itself. */
  canonical?: string
  wide?: boolean
}

const { title, description, canonical, wide = false } = Astro.props
const base = import.meta.env.BASE_URL
const href = canonical ?? new URL(Astro.url.pathname, Astro.site).href
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={href} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="robots" content="index,follow" />
  </head>
  <body>
    <div class:list={["site", wide && "site-fixed"]}>
      <header class="site-head">
        <h1><a href={base}>Orchard Map</a></h1>
        <p class="tagline">Apple picking within a day trip of New York</p>
        <nav>
          <a href={base}>Map</a>
          <a href={`${base}varieties`}>Calendar</a>
          <a href={`${base}about`}>About</a>
          <BuildTag />
        </nav>
      </header>

      {wide ? <slot /> : <main class="page"><slot /></main>}

      {/*
        One line, because the second one was saying what three other places
        already say better. The tile credits — CARTO, OpenStreetMap — are in
        MapLibre's own attribution control on the map page, which is the only
        page whose tiles need crediting. The listing provenance is on About
        under Licences, per source and with counts, and on each farm's own page
        as the row it actually applies to; a footer summary of "most stating no
        licence" was a fourth, vaguer copy that no source could check itself
        against. What survives is the part that is nowhere else: ring ahead.
      */}
      <footer class:list={["site-foot", wide && "site-foot-compact"]}>
        <p class="foot-short">
          Not every farm's hours are checked — <strong>ring ahead</strong>.
          {/* Short labels because the line has to survive a 375px phone in one
              row; "Where this comes from" is the nicer phrase and does not. The
              repo link drops out at that width too — it is on About, and a
              phone is not where anybody opens it. */}
          <a href={`${base}about`}>About</a>
          <a class="foot-repo" href="https://github.com/minormending/orchard-map" rel="noreferrer">Source</a>
        </p>
      </footer>
    </div>
  </body>
</html>
