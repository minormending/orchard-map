---
import Base from '../layouts/Base.astro'
import Calendar from '../components/ui/Calendar.astro'
import Callout from '../components/ui/Callout.astro'
import FactsTable from '../components/ui/FactsTable.astro'
import Unknown from '../components/ui/Unknown.astro'
import { VARIETIES } from '../lib/season'

/**
 * The picking calendar, rendered statically.
 *
 * This page is deliberately timeless: it says when each apple is *usually*
 * ready, which is true whenever somebody reads it. The "ripe right now"
 * reading is done in the browser on the map page, because a static build
 * freezes today at deploy day.
 *
 * It is also the page most likely to earn its keep in search — "when are
 * honeycrisps ready in new york" is a real query with a real answer.
 */
/* The axis arithmetic lives in lib/season.ts and the markup in ui/Calendar,
   because the orchard pages draw the same bars. One calendar, two pages. */
---
<Base
  title="When each apple is ripe in New York | Orchard Map"
  description="A picking calendar for 30 apple varieties grown in New York — when Honeycrisp, McIntosh, Cortland, Macoun and the rest are usually ready in the Hudson Valley."
>
  <h1>The picking calendar</h1>
  <p class="where">
    When each variety is usually ready in the Hudson Valley, from the first
    Jersey Macs in August to EverCrisp in November.
  </p>

  <Callout>
    <p>
      <strong>These are regional averages, not a report from any farm.</strong> A warm
      spring pulls the whole calendar a week earlier and a cold one pushes it later,
      and any given orchard sits a week either side of the region.
    </p>
    <p>
      They are also <em>picking</em> windows, not shop availability. Several of these
      apples are sold from cold storage into the spring — that does not mean there is
      anything on the tree.
    </p>
  </Callout>

  {/* The whole roster, so the "now" badge marks the handful that are ready
      against the ones that are not — which is the reading this page is for. */}
  <Calendar varieties={VARIETIES} scale />

  <h2>What they are good for</h2>
  <FactsTable>
    {VARIETIES.map((v) => (
      <tr>
        <th>{v.name}</th>
        <td>
          {v.best_for.length > 0
            ? v.best_for.join('. ')
            : <Unknown>Not described</Unknown>}
          {v.hint && <><br /><small class="muted">{v.hint}</small></>}
        </td>
      </tr>
    ))}
  </FactsTable>

  <h2>Where these came from</h2>
  <p>
    The variety names, flavour profiles and uses are the
    <a href="https://www.applesfromny.com/" rel="noreferrer nofollow">New York Apple
    Association</a>'s, which states no licence for them.
  </p>
  <p>
    The picking windows are <strong>not</strong> theirs. The association publishes an
    availability line — Braeburn reads "October through April" — which is when you can
    buy the apple from controlled-atmosphere storage, not when you can pick it.
    Treating that as a harvest window would have this page telling you to go and pick
    Braeburns in March. The windows here are compiled separately from Cornell
    Cooperative Extension harvest charts and orchards' own published calendars, and
    are marked as estimates throughout.
  </p>
</Base>
