---
import Base from '../../layouts/Base.astro'
import Button from '../../components/ui/Button'
import Calendar from '../../components/ui/Calendar.astro'
import Callout from '../../components/ui/Callout.astro'
import FactsTable from '../../components/ui/FactsTable.astro'
import Unknown from '../../components/ui/Unknown.astro'
import { ORCHARDS, addressLine, directionsUrl, telUrl } from '../../lib/orchards'
import { distanceM, milesLabel, tagLabels } from '../../lib/filters'
import { ripeNow } from '../../lib/season'
import { VARIETY_BY_SLUG } from '../../lib/season'
import { checkedState, pickingLine, hasFarmData, HOURS_FRESHNESS } from '../../lib/checked'
import { creditFor, fieldCredits } from '../../lib/sources'
import type { Orchard } from '../../lib/types'

/**
 * A real page per orchard, which is the whole reason this is Astro.
 *
 * "apple picking warwick ny" is the query that matters, and a single-page app
 * cannot rank for it — there is one URL and its markup is a loading state.
 * These 189 pages are the crawlable surface; the map is the tool people use
 * once they are here.
 */
export function getStaticPaths() {
  return ORCHARDS.map((orchard) => ({
    params: { slug: orchard.slug },
    props: { orchard },
  }))
}

interface Props { orchard: Orchard }
const { orchard } = Astro.props
const base = import.meta.env.BASE_URL

const where = addressLine(orchard)
const tags = tagLabels(orchard)
const upick = orchard.tags.includes('pick_your_own')

/*
 * Rendered at build time, which is only honest because deploy.yml rebuilds
 * nightly through the season. The date is printed alongside it so a stale
 * build says so rather than quietly implying today.
 */
const built = new Date()
const ripe = ripeNow(built)
const builtLabel = built.toLocaleDateString('en-US', { day: 'numeric', month: 'long' })

const farmData = hasFarmData(orchard)
const checked = checkedState(orchard, HOURS_FRESHNESS, built)
const credit = creditFor(orchard)
const enriched = fieldCredits(orchard)
const approximate = orchard.position_precision === 'approximate'
const grows = (orchard.varieties ?? [])
  .map((v) => VARIETY_BY_SLUG.get(v))
  .filter((v) => v !== undefined)

/** This farm's own apples, narrowed to the ones the calendar says are ready. */
const ripeSlugs = new Set(ripe.map((v) => v.slug))
const ripeHere = grows.filter((v) => ripeSlugs.has(v!.slug))

const nearby = ORCHARDS
  .filter((o) => o.slug !== orchard.slug)
  .map((o) => ({ o, d: distanceM(orchard, o) }))
  .sort((a, b) => a.d - b.d)
  .slice(0, 5)

const title = `${orchard.name}${orchard.town ? ` — ${orchard.town}, ${orchard.state}` : ''}`
const description = upick
  ? `${orchard.name} is a pick-your-own apple orchard in ${orchard.town ?? 'New York'}. Directions, phone and what it offers — plus what nobody has checked yet.`
  : `${orchard.name} in ${orchard.town ?? 'New York'}: ${tags.join(', ').toLowerCase() || 'an apple grower'}. Directions, phone and hours.`

/**
 * Schema.org, with a deliberate omission: no `openingHours`.
 *
 * We do not know them. Every orchard site sampled while scoping this published
 * none in machine-readable form, so emitting a guess would put a wrong answer
 * into Google's knowledge panel — where it would outlive any correction made
 * here. An absent field is recoverable; a confident wrong one is not.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': upick ? 'Farm' : 'LocalBusiness',
  name: orchard.name,
  ...(orchard.phone ? { telephone: orchard.phone } : {}),
  ...(orchard.website ? { url: orchard.website } : {}),
  address: {
    '@type': 'PostalAddress',
    ...(orchard.address ? { streetAddress: orchard.address } : {}),
    ...(orchard.town ? { addressLocality: orchard.town } : {}),
    ...(orchard.state ? { addressRegion: orchard.state } : {}),
    ...(orchard.zip ? { postalCode: orchard.zip } : {}),
    addressCountry: 'US',
  },
  geo: { '@type': 'GeoCoordinates', latitude: orchard.lat, longitude: orchard.lng },
}
---
<Base title={`${title} | Orchard Map`} description={description}>
  <p class="crumbs"><a href={base}>← All orchards</a></p>

  {/*
    The other half of the shared-element transition: the name a visitor clicked
    in "Nearest others" on the previous orchard page is this heading, so the
    browser moves it rather than cutting.

    More than one name pairs, which is worth knowing before it looks like a
    bug. Every farm named on a page carries one — this heading and all five
    "Nearest others" links — and the browser pairs each name it finds in both
    documents. Between two farms that are mutual neighbours, that is all six:
    the clicked link grows into this heading, THIS page's heading shrinks into
    a link on the next, and the four entries the two lists share slide to their
    new positions. Between two distant farms the lists do not overlap, nothing
    pairs, and it is a plain cross-fade.

    That is the intended behaviour rather than a side effect to be trimmed —
    related farms stay anchored while the page changes — but it is six moving
    parts, so anybody tuning this should know the count is a property of how
    much the two neighbour lists overlap and not of anything set here.

    (An earlier version of this comment claimed only the navigated farm paired
    and every other link stayed put. It does not, and it never did.)
  */}
  <h1 transition:name={`orchard-${orchard.slug}`}>{orchard.name}</h1>
  {where && <p class="where">{where}</p>}

  <p>
    <Button href={directionsUrl(orchard)} target="_blank" rel="noreferrer">Directions</Button>
    {orchard.phone && <Button variant="quiet" href={telUrl(orchard.phone)}>{orchard.phone}</Button>}
    {orchard.website && (
      <Button variant="quiet" href={orchard.website} target="_blank" rel="noreferrer nofollow">
        Their website
      </Button>
    )}
    <Button variant="quiet" href={`${base}?at=${orchard.slug}`}>Show on the map</Button>
  </p>

  {/*
    * Directions navigates to the coordinate, not to the name, so when the
    * coordinate is the road rather than the gate this has to be said next to
    * the button rather than buried in the details table. The farm is addressed
    * from the route because that is genuinely where it is; the geocoder can
    * find the road and not the driveway.
    */}
  {approximate && (
    <p class="caveat">
      <strong>This pin is approximate.</strong> {orchard.name} is addressed from
      the road rather than a house number, so the map shows the right road in the
      right town — possibly some way from the entrance.
      {orchard.phone ? ' Ring ahead for directions.' : ' Look for their sign.'}
    </p>
  )}

  <h2>What they do</h2>
  {/*
    The same pill the map filters with. It is one taxonomy — what a farm does
    and what you can filter for are the same list — so rendering it as chips
    on one page and bullets on the other was two vocabularies for one idea.
  */}
  {tags.length > 0 ? (
    <ul class="tags">{tags.map((t) => <li class="tag">{t}</li>)}</ul>
  ) : (
    <Unknown as="p">{credit.name} lists them without a category.</Unknown>
  )}

  <h2>What is usually ripe now</h2>
  {grows.length > 0 ? (
    /*
     * The payoff of the whole pipeline: this farm's own list, narrowed to what
     * the calendar says is ready. Until the scraper read their site this page
     * could only say what the region does on average — which is useful, and is
     * not the same as an answer about the orchard you are about to drive to.
     */
    ripeHere.length > 0 ? (
      <>
        <p>
          {orchard.name} grows {grows.length} {grows.length === 1 ? 'variety' : 'varieties'} we know of,
          and as of {builtLabel} these are usually ready:
        </p>
        {/*
          The calendar's own bars, not a bulleted restatement of them. A date
          range read as prose — "early September to late September" — is a
          sentence you have to hold in your head to compare two varieties; the
          same fact as a bar is a picture you can read at a glance, and it is
          already drawn on the Calendar page for the whole region.
        */}
        <Calendar varieties={ripeHere} date={built} inline allRipe />
        <p class="muted">
          Their list, our calendar. Seasons move a week or two with the weather and
          this is not a report from the trees —
          <a href={`${base}varieties`}> the whole calendar</a>.
        </p>
      </>
    ) : (
      <p class="muted">
        None of the {grows.length} varieties {orchard.name} grows is usually ready at
        this point in the year. <a href={`${base}varieties`}>The picking calendar</a>
        shows when each one comes in.
      </p>
    )
  ) : ripe.length > 0 ? (
    <>
      <p>
        As of {builtLabel}, Hudson Valley orchards are usually picking
        {' '}{ripe.map((v) => v.name).join(', ')}.
      </p>
      <Calendar varieties={ripe} date={built} inline allRipe />
      <p class="muted">
        Regional timing, <strong>not</strong> a report from this farm — nobody has
        recorded which varieties {orchard.name} grows. <a href={`${base}varieties`}>The
        whole calendar</a>.
      </p>
    </>
  ) : (
    <p class="muted">
      Nothing is usually being picked in the Hudson Valley at this point in the year.
      <a href={`${base}varieties`}> The picking calendar</a> shows when each variety
      comes in.
    </p>
  )}

  {farmData ? (
    <>
      <h2>What the farm says</h2>
      <Callout>
        <p>{pickingLine(orchard, built)}</p>
        <p>
          Everything below was read from {orchard.source_url
            ? <a href={orchard.source_url} rel="noreferrer nofollow">their own website</a>
            : 'their own website'}, {checked?.ago}, by a machine. Nobody rang them.
        </p>
      </Callout>
    </>
  ) : (
    <>
      <h2>What we do not know</h2>
      <Callout>
        <p>
          <strong>Nobody has checked this farm's hours, prices, or whether picking is
          open.</strong> Everything above came from a trade-association roster, which says
          the farm exists and sells apples — not that you can pick them this weekend.
        </p>
        <p>
          Fields like dogs, restrooms, hayrides and cider donuts are deliberately absent
          rather than shown as "no". An empty answer is honest; a wrong one costs you a
          two-hour drive.
        </p>
      </Callout>
    </>
  )}

  <h2>Details</h2>
  <FactsTable>
      <tr>
        <th>Opening hours</th>
        <td>{orchard.hours ?? <Unknown>Not checked</Unknown>}</td>
      </tr>
      <tr>
        {/* "This season", matching what the field actually means. Whether they
            are open on any given day is the row above it, which is their own
            wording rather than our interpretation of it. */}
        <th>Picking this season</th>
        <td>
          {orchard.upick_open === true ? 'Yes, per the farm'
            : orchard.upick_open === false ? 'No, per the farm'
            : <Unknown>Not checked</Unknown>}
        </td>
      </tr>
      <tr>
        <th>Admission</th>
        <td>{orchard.admission ?? <Unknown>Not checked</Unknown>}</td>
      </tr>
      <tr>
        <th>Reservations</th>
        <td>
          {orchard.reservations_required === true ? 'Required'
            : orchard.reservations_required === false ? 'Not required'
            : <Unknown>Not checked</Unknown>}
        </td>
      </tr>
      <tr>
        <th>Varieties they grow</th>
        <td>
          {grows.length > 0
            ? grows.map((v) => v!.name).join(', ')
            : <Unknown>Not recorded yet</Unknown>}
        </td>
      </tr>
      <tr>
        <th>Last checked</th>
        <td>{checked ? checked.ago : <Unknown>Never</Unknown>}</td>
      </tr>
      <tr>
        <th>Listed by</th>
        <td>
          {credit.name} ({credit.licenceUrl
            ? <a href={credit.licenceUrl} rel="noreferrer">{credit.licence}</a>
            : credit.licence}), imported {orchard.imported_at}
          {/*
            Named separately when a field came from somewhere else, because
            crediting the row's source for it would be attributing somebody
            else's work. This page used to say OpenStreetMap supplied an
            address the Connecticut board supplied.
          */}
          {enriched.map((e) => (
            <span class="credit-extra">
              <br />{e.fields.join(', ')} from {e.name}
            </span>
          ))}
        </td>
      </tr>
  </FactsTable>

  <h2>Nearest others</h2>
  <ul class="nearby">
    {nearby.map(({ o, d }) => (
      <li>
        <a href={`${base}orchard/${o.slug}`} transition:name={`orchard-${o.slug}`}>{o.name}</a>
        <span class="n-where"> — {o.town}, {milesLabel(d)} away</span>
      </li>
    ))}
  </ul>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</Base>
